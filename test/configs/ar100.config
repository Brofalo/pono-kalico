# Base config file for the ar100 CPU
CONFIG_MACH_AR100=y
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
CONFIG_WANT_SOFTWARE_I2C=n
CONFIG_WANT_SOFTWARE_SPI=n
CONFIG_WANT_LIS2DW=n
CONFIG_WANT_HX71X=n
# The hx711s driver does not fit here. Its text alone is about 22KB against
# roughly 4.6KB of headroom in SRAM_A2, so no buffer sizing recovers it.
CONFIG_WANT_HX711S=n
CONFIG_WANT_ADS1220=n
CONFIG_WANT_SENSOR_ANGLE=n
